{
  "expo": {
    "name": "FiyatRadar",
    "slug": "fiyatradar",
    "scheme": "fiyatradar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#6366F1" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiyatradar.app",
      "infoPlist": { "UIBackgroundModes": ["remote-notification"] }
    },
    "android": {
      "package": "com.fiyatradar.app",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#6366F1" },
      "permissions": ["POST_NOTIFICATIONS", "RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-font"],
    "experiments": { "typedRoutes": true },
    "locales": { "tr": "./assets/locales/tr.json" }
  }
}
